# Instagram / Meta credentials
# Never commit the real .env file — it is excluded by .gitignore

# From your Meta developer app → Instagram → Access token
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here

# Your Instagram Professional account's numeric ID
INSTAGRAM_ACCOUNT_ID=your_instagram_user_id_here

# --- Optional tuning ---
# Minimum puzzle rating (default 1200)
PUZZLE_RATING_MIN=1200
# Maximum puzzle rating (default 2200)
PUZZLE_RATING_MAX=2200
# Comma-separated Lichess theme tags to include (leave blank = any theme)
PUZZLE_THEMES=
